#!/usr/bin/env bash
#
# wireproxyctl - manage wireproxy profiles as systemd services
#
# SPDX-License-Identifier: GPL-3.0-or-later

set -uo pipefail

readonly VERSION="1.0.0"

# --- Paths (overridable via environment) ---
readonly WP_BIN="${WIREPROXY_BIN:-/usr/local/bin/wireproxy}"
readonly CONF_DIR="${WIREPROXY_CONF_DIR:-/etc/wireproxy}"
readonly UNIT_DIR="${WIREPROXY_UNIT_DIR:-/etc/systemd/system}"
readonly UNIT_FILE="$UNIT_DIR/wireproxy@.service"

readonly UPSTREAM_REPO="windtf/wireproxy"
readonly DEFAULT_BIND="127.0.0.1"
readonly DEFAULT_PORT=1080
PROG=${0##*/}
readonly PROG

TMP_DIR=""

# --- Output ---
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[1;33m' BLUE=$'\033[0;34m' NC=$'\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' NC=''
fi

header() { printf '%s=== %s ===%s\n' "$BLUE" "$*" "$NC"; }
info()   { printf '%s\n' "$*"; }
ok()     { printf '%s%s%s\n' "$GREEN" "$*" "$NC"; }
warn()   { printf '%s%s%s\n' "$YELLOW" "$*" "$NC" >&2; }
die()    { printf '%s%s%s\n' "$RED" "$*" "$NC" >&2; exit 1; }

usage() {
    cat <<EOF
Usage: $PROG [COMMAND] [OPTIONS]

Manage wireproxy (WireGuard to SOCKS5) profiles as systemd services.
Run without a command to open the interactive menu.

Commands:
  install                   Install wireproxy and the systemd unit template
  list                      List profiles with their address and status
  add [NAME] [OPTIONS]      Create a profile (prompts for anything not given)
      -p, --port PORT         SOCKS5 port (default: first free port from $DEFAULT_PORT)
      -b, --bind ADDR         Listen address (default: $DEFAULT_BIND)
  edit [NAME]               Edit a profile, validate it and restart it if running
  remove [NAME] [-y]        Remove a profile and its keys
  uninstall [-y] [--purge]  Remove wireproxy and the unit template;
                            --purge also deletes all profiles
  help                      Show this help
  version                   Show the version

Profiles are stored in $CONF_DIR/NAME.conf and run as wireproxy@NAME.service.
EOF
}

# --- Helpers ---

cleanup() {
    if [[ -n $TMP_DIR ]]; then
        rm -rf "$TMP_DIR"
    fi
}

make_tmp_dir() {
    TMP_DIR=$(mktemp -d) || die "Failed to create a temporary directory."
    trap cleanup EXIT
}

# Re-run the whole command through sudo when not root.
ensure_root() {
    [[ $EUID -eq 0 ]] && return 0
    command -v sudo >/dev/null 2>&1 || die "$PROG must be run as root."
    exec sudo -- "$(readlink -f "${BASH_SOURCE[0]}")" "$@"
}

require_installed() {
    [[ -x $WP_BIN ]] || die "wireproxy is not installed at $WP_BIN. Run '$PROG install' first."
}

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

no_args() {
    (($# == 0)) || die "Unexpected argument: $1 (see '$PROG --help')"
}

# Fail unless an option ($1) has a value ($2).
need_value() {
    [[ $# -ge 2 && -n $2 ]] || die "Option $1 requires a value."
}

# Prompt on stderr and print the answer (or the default) on stdout.
ask() {
    local prompt=$1 default=${2:-} reply
    [[ -n $default ]] && prompt+=" [$default]"
    read -r -p "$prompt: " reply || return 1
    printf '%s' "${reply:-$default}"
}

confirm() {
    local reply
    read -r -p "$1 (y/N): " reply || return 1
    [[ $reply == [yY] ]]
}

profile_conf() { printf '%s/%s.conf' "$CONF_DIR" "$1"; }
unit_name()    { printf 'wireproxy@%s.service' "$1"; }

list_profiles() {
    local f
    for f in "$CONF_DIR"/*.conf; do
        [[ -f $f ]] || continue
        f=${f##*/}
        printf '%s\n' "${f%.conf}"
    done
}

# Print the first BindAddress found in a profile config.
profile_bind() {
    sed -nE 's/^[[:space:]]*BindAddress[[:space:]]*=[[:space:]]*([^[:space:]]+).*/\1/Ip' \
        "$(profile_conf "$1")" 2>/dev/null | sed -n 1p
}

# Print the name of the profile that already uses the given port, if any.
port_owner() {
    local port=$1 name bind
    while IFS= read -r name; do
        bind=$(profile_bind "$name")
        if [[ ${bind##*:} == "$port" ]]; then
            printf '%s' "$name"
            return 0
        fi
    done < <(list_profiles)
    return 1
}

next_free_port() {
    local port=$DEFAULT_PORT
    while port_owner "$port" >/dev/null; do
        ((port++))
    done
    printf '%s' "$port"
}

validate_name() {
    [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] ||
        die "Invalid profile name '$1': use letters, digits, '-' and '_' only."
}

validate_port() {
    if ! [[ $1 =~ ^[0-9]+$ ]] || (( 10#$1 < 1 || 10#$1 > 65535 )); then
        die "Invalid port '$1': must be a number between 1 and 65535."
    fi
}

validate_bind() {
    [[ $1 =~ ^[0-9A-Fa-f:.]+$ ]] || die "Invalid listen address '$1'."
}

require_profile() {
    validate_name "$1"
    [[ -f $(profile_conf "$1") ]] || die "Profile '$1' not found."
}

# Show existing profiles and ask for one of them.
pick_profile() {
    local profiles
    profiles=$(list_profiles)
    [[ -n $profiles ]] || die "No profiles found."
    printf 'Profiles:\n  %s\n' "${profiles//$'\n'/$'\n  '}" >&2
    ask "Profile name" || die "Aborted."
}

check_port_free() {
    local port=$1 owner
    if owner=$(port_owner "$port"); then
        die "Port $port is already used by profile '$owner'."
    fi
    if command -v ss >/dev/null 2>&1 && [[ -n $(ss -Hltn "sport = :$port" 2>/dev/null) ]]; then
        die "Port $port is already in use by another process."
    fi
}

detect_arch() {
    case $(uname -m) in
        x86_64 | amd64)   echo amd64 ;;
        aarch64 | arm64)  echo arm64 ;;
        armv6l | armv7l)  echo arm ;;
        i386 | i686)      echo 386 ;;
        riscv64)          echo riscv64 ;;
        s390x)            echo s390x ;;
        *) die "Unsupported architecture: $(uname -m)" ;;
    esac
}

# --- Commands ---

install_binary() {
    local arch asset url
    need_cmd curl
    need_cmd tar

    arch=$(detect_arch) || exit 1
    asset="wireproxy_linux_${arch}.tar.gz"
    url="https://github.com/$UPSTREAM_REPO/releases/latest/download/$asset"
    make_tmp_dir

    local progress=-sS
    [[ -t 2 ]] && progress=-#

    info "Downloading $asset ..."
    curl -fL --proto '=https' --tlsv1.2 "$progress" -o "$TMP_DIR/$asset" "$url" ||
        die "Download failed. Please check your internet connection."

    tar --no-same-owner -xzf "$TMP_DIR/$asset" -C "$TMP_DIR" wireproxy ||
        die "Failed to extract $asset."

    # Install next to the target and rename, so a running binary is replaced atomically.
    install -m 0755 "$TMP_DIR/wireproxy" "$WP_BIN.new" || die "Failed to install wireproxy to $WP_BIN."
    mv -f "$WP_BIN.new" "$WP_BIN" || die "Failed to install wireproxy to $WP_BIN."

    ok "Installed $("$WP_BIN" --version 2>/dev/null) to $WP_BIN."
}

write_unit() {
    info "Writing systemd unit template $UNIT_FILE ..."
    cat >"$UNIT_FILE" <<EOF || die "Failed to write $UNIT_FILE."
[Unit]
Description=wireproxy (%i)
Documentation=https://github.com/$UPSTREAM_REPO
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=$WP_BIN -c $CONF_DIR/%i.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload || die "systemctl daemon-reload failed."
}

cmd_install() {
    no_args "$@"
    header "Installing wireproxy"

    if [[ -x $WP_BIN ]]; then
        warn "wireproxy is already installed at $WP_BIN; skipping download."
    else
        install_binary
    fi

    write_unit
    install -d -m 700 "$CONF_DIR" || die "Failed to create $CONF_DIR."
    ok "Installation finished. Create a profile with: $PROG add"
}

cmd_list() {
    no_args "$@"
    local name unit bind enabled active
    local fmt='%-24s %-22s %-10s %s\n'
    local profiles
    profiles=$(list_profiles)
    if [[ -z $profiles ]]; then
        info "No profiles found. Create one with: $PROG add"
        return 0
    fi

    # shellcheck disable=SC2059
    printf "$fmt" NAME LISTEN BOOT STATUS
    while IFS= read -r name; do
        unit=$(unit_name "$name")
        bind=$(profile_bind "$name")
        enabled=$(systemctl is-enabled "$unit" 2>/dev/null)
        active=$(systemctl is-active "$unit" 2>/dev/null)
        # shellcheck disable=SC2059
        printf "$fmt" "$name" "${bind:--}" "${enabled:-unknown}" "${active:-unknown}"
    done <<<"$profiles"
}

cmd_add() {
    require_installed

    local name="" port="" bind="" interactive=false listen conf
    while (($#)); do
        case $1 in
            -p | --port) need_value "$@"; port=$2; shift 2 ;;
            -b | --bind) need_value "$@"; bind=$2; shift 2 ;;
            --port=*) port=${1#*=}; shift ;;
            --bind=*) bind=${1#*=}; shift ;;
            -*) die "Unknown option: $1 (see '$PROG --help')" ;;
            *)
                [[ -z $name ]] || die "Unexpected argument: $1"
                name=$1
                shift
                ;;
        esac
    done

    header "Adding a new profile"

    if [[ -z $name ]]; then
        interactive=true
        name=$(ask "Profile name (e.g. office, jp-server)") || die "Aborted."
    fi
    validate_name "$name"
    conf=$(profile_conf "$name")
    [[ ! -e $conf ]] || die "Profile '$name' already exists."

    if [[ -z $port ]]; then
        port=$(next_free_port)
        if $interactive; then
            port=$(ask "Local SOCKS5 port" "$port") || die "Aborted."
        fi
    fi
    validate_port "$port"
    check_port_free "$port"

    if [[ -z $bind ]]; then
        bind=$DEFAULT_BIND
        if $interactive; then
            info "Listen address: 127.0.0.1 = this machine only, 0.0.0.0 = all interfaces."
            bind=$(ask "Listen address" "$bind") || die "Aborted."
        fi
    fi
    validate_bind "$bind"
    if [[ $bind == *:* ]]; then
        listen="[$bind]:$port"
    else
        listen="$bind:$port"
    fi
    if [[ $bind == 0.0.0.0 || $bind == :: ]]; then
        warn "The SOCKS5 proxy will be reachable from other hosts without authentication."
    fi

    install -d -m 700 "$CONF_DIR" || die "Failed to create $CONF_DIR."
    (
        umask 077
        cat >"$conf" <<EOF
# wireproxy profile: $name
# Fill in [Interface] and [Peer] with the values from your VPN provider.

[Interface]
PrivateKey = <Insert Private Key Here>
Address = 10.0.0.2/32
DNS = 1.1.1.1
MTU = 1280

[Peer]
PublicKey = <Insert Server Public Key Here>
Endpoint = <IP>:51820
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25

[Socks5]
BindAddress = $listen
EOF
    ) || die "Failed to write $conf."

    systemctl enable "$(unit_name "$name")" 2>/dev/null ||
        warn "Failed to enable $(unit_name "$name")."

    ok "Profile '$name' created."
    info "  Config file:    ${YELLOW}$conf${NC}"
    info "  systemd unit:   ${YELLOW}$(unit_name "$name")${NC} (enabled at boot)"
    info "  SOCKS5 address: ${YELLOW}$listen${NC}"
    info ""
    info "${RED}Next step:${NC} fill in your real keys and endpoint:"
    info "  $PROG edit $name"
}

# Open $1 in the user's editor.
run_editor() {
    local editor=${SUDO_EDITOR:-${VISUAL:-${EDITOR:-}}}
    if [[ -z $editor ]]; then
        if command -v nano >/dev/null 2>&1; then editor='nano'; else editor='vi'; fi
    fi
    # Editor variables may contain arguments (e.g. "code --wait").
    # shellcheck disable=SC2086
    $editor "$1"
}

cmd_edit() {
    require_installed

    local name=${1:-} conf work unit
    (($# <= 1)) || die "Unexpected argument: $2"
    [[ -n $name ]] || name=$(pick_profile) || exit 1
    require_profile "$name"
    conf=$(profile_conf "$name")
    unit=$(unit_name "$name")

    # Edit a private copy, and only replace the profile once it passes validation.
    make_tmp_dir
    work="$TMP_DIR/$name.conf"
    cp "$conf" "$work" || die "Failed to copy $conf."

    while true; do
        run_editor "$work" || die "Editor exited with an error; changes discarded."
        if cmp -s "$conf" "$work"; then
            info "No changes."
            return 0
        fi
        if "$WP_BIN" -n -c "$work"; then
            break
        fi
        warn "The configuration is invalid (see above)."
        confirm "Edit again? Answering no discards your changes." ||
            { info "Changes discarded."; return 0; }
    done

    install -m 600 "$work" "$conf" || die "Failed to save $conf."
    ok "Profile '$name' saved."

    if systemctl is-active --quiet "$unit"; then
        systemctl restart "$unit" || die "Failed to restart $unit."
        ok "Restarted $unit."
    elif confirm "Start $unit now?"; then
        systemctl start "$unit" || die "Failed to start $unit (see: journalctl -u $unit)."
        ok "Started $unit."
    fi
}

cmd_remove() {
    local name="" yes=false
    while (($#)); do
        case $1 in
            -y | --yes) yes=true ;;
            -*) die "Unknown option: $1 (see '$PROG --help')" ;;
            *) [[ -z $name ]] || die "Unexpected argument: $1"; name=$1 ;;
        esac
        shift
    done

    header "Removing a profile"
    [[ -n $name ]] || name=$(pick_profile) || exit 1
    require_profile "$name"

    if ! $yes; then
        confirm "Delete profile '$name' (including its private key)?" ||
            { info "Cancelled."; return 0; }
    fi

    systemctl disable --now "$(unit_name "$name")" 2>/dev/null
    rm -f "$(profile_conf "$name")" || die "Failed to delete $(profile_conf "$name")."
    ok "Profile '$name' removed."
}

cmd_uninstall() {
    local yes=false purge=""
    while (($#)); do
        case $1 in
            -y | --yes) yes=true ;;
            --purge) purge=true ;;
            *) die "Unknown option: $1 (see '$PROG --help')" ;;
        esac
        shift
    done

    header "Uninstalling wireproxy"
    if ! $yes; then
        confirm "Stop all profiles and remove the wireproxy binary and systemd unit?" ||
            { info "Cancelled."; return 0; }
    fi

    local name units=()
    mapfile -t units < <(
        {
            list_profiles | while IFS= read -r name; do unit_name "$name"; echo; done
            systemctl list-units --all --plain --no-legend 'wireproxy@*' 2>/dev/null | awk '{print $1}'
        } | sort -u
    )
    if ((${#units[@]})); then
        info "Stopping and disabling: ${units[*]}"
        systemctl disable --now "${units[@]}" 2>/dev/null
    fi

    rm -f "$UNIT_FILE" "$WP_BIN"
    systemctl daemon-reload
    ok "wireproxy binary and systemd unit removed."

    if [[ -z $purge ]] && ! $yes; then
        confirm "Also delete $CONF_DIR? This removes all profiles and keys and cannot be undone!" &&
            purge=true
    fi
    if [[ $purge == true ]]; then
        rm -rf "$CONF_DIR"
        ok "Config directory deleted."
    else
        info "Config directory preserved: $CONF_DIR"
    fi
}

# --- Interactive menu ---

menu() {
    local choice
    while true; do
        printf '\n%s--- %s %s ---%s\n' "$BLUE" "$PROG" "$VERSION" "$NC"
        info "1. Install wireproxy"
        info "2. List profiles"
        info "3. Add a profile"
        info "4. Edit a profile"
        info "5. Remove a profile"
        info "6. Uninstall wireproxy"
        info "0. Exit"
        read -r -p "Select [0-6]: " choice || { echo; return 0; }

        # Run each action in a subshell so that `die` only aborts that action.
        case $choice in
            1) ( cmd_install ) && confirm "Create a profile now?" && ( cmd_add ) ;;
            2) ( cmd_list ) ;;
            3) ( cmd_add ) ;;
            4) ( cmd_edit ) ;;
            5) ( cmd_remove ) ;;
            6) ( cmd_uninstall ) ;;
            0) return 0 ;;
            *) warn "Invalid option, please try again." ;;
        esac
    done
}

main() {
    case ${1:-} in
        help | -h | --help) usage; return 0 ;;
        version | -V | --version) info "$PROG $VERSION"; return 0 ;;
    esac

    ensure_root "$@"

    local cmd=${1:-}
    (($#)) && shift
    case $cmd in
        "") menu ;;
        install) cmd_install "$@" ;;
        list | ls) cmd_list "$@" ;;
        add) cmd_add "$@" ;;
        edit) cmd_edit "$@" ;;
        remove | rm) cmd_remove "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        *) die "Unknown command: $cmd (see '$PROG --help')" ;;
    esac
}

main "$@"
